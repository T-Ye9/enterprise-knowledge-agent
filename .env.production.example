# 复制到本地 .env 或平台变量中；密钥不能提交。
APP_ENV=production
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ALLOW_DOCUMENT_UPLOAD=false
# 仅用于预置公开 Demo；启动时复用 ingestion 重建两份样例文档。
BOOTSTRAP_DEMO_KNOWLEDGE_BASE=true
VITE_ALLOW_DOCUMENT_UPLOAD=false
# 同源 /api 代理设为空；分离前后端时填写实际 HTTPS 前端 origin。
CORS_ORIGINS=
# 此处匹配现有 Compose 的两个卷。
KNOWLEDGE_DB_PATH=/app/data/vector-db
EMBEDDING_CACHE_DIR=/app/.cache/embeddings
# 托管平台仅挂一个卷时，改为其实际挂载路径下的两个子目录。
# KNOWLEDGE_DB_PATH=/app/storage/vector-db
# EMBEDDING_CACHE_DIR=/app/storage/embeddings
# HF_HOME=/app/storage/huggingface
# Compose 内部端口固定 8000；托管平台可注入自己的 PORT。
