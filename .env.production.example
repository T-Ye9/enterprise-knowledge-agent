# 后端生产变量参考；Railway 的非敏感值由 .railway/railway.ts 管理，密钥仅在平台填写。
APP_ENV=production
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ALLOW_DOCUMENT_UPLOAD=false
# 仅用于预置公开 Demo；启动时复用 ingestion 重建两份样例文档。
BOOTSTRAP_DEMO_KNOWLEDGE_BASE=true
# Railway 后端 + Render 前端：填写 Render 站点的 HTTPS origin，不要加末尾斜杠。
CORS_ORIGINS=
# 无持久卷；重启时依靠公开 Demo PDF 重建。
KNOWLEDGE_DB_PATH=/app/data/vector-db
EMBEDDING_CACHE_DIR=/app/.cache/embeddings
# PORT 由 Railway 提供；VITE_* 仅在 Render 前端配置。
