    {"id":"K08","category":"knowledge","question":"Project Cedar 健康补贴材料需要在什么时候提交？","expected_tools":["search_knowledge_base"],"facts":[{"document":"web-demo-policy.pdf","page":1,"quote":"次月 5 日前","answer_pattern":"次月(?:5|五)日(?:之)?前|下(?:个)?月(?:5|五)(?:日|号)(?:之)?前"}]},
