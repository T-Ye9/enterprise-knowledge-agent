    {"id":"K02","category":"knowledge","question":"公司每天几点上班、几点下班？","expected_tools":["search_knowledge_base"],"facts":[{"document":"demo-company-policy.pdf","page":1,"quote":"上午九点至下午六点","answer_pattern":"(?:九点|9[:：]00|9点|09[:：]00).*(?:六点|6[:：]00|6点|18[:：]00|18点)"}]},
    {"id":"K03","category":"knowledge","question":"休假申请需要提前几个工作日提交？","expected_tools":["search_knowledge_base"],"facts":[{"document":"demo-company-policy.pdf","page":1,"quote":"提前三个工作日","answer_pattern":"(?:三|3)个工作日"}]},
    {"id":"K04","category":"knowledge","question":"出差返回后多久必须提交报销？","expected_tools":["search_knowledge_base"],"facts":[{"document":"demo-company-policy.pdf","page":2,"quote":"返回后十个工作日内提交","answer_pattern":"(?:十|10)个工作日"}]},
    {"id":"K05","category":"knowledge","question":"差旅报销需要哪些材料？","expected_tools":["search_knowledge_base"],"facts":[{"document":"demo-company-policy.pdf","page":2,"quote":"发票及费用说明","answer_pattern":"发票.*费用说明"}]},
    {"id":"K06","category":"knowledge","question":"差旅需要事先由谁批准？","expected_tools":["search_knowledge_base"],"facts":[{"document":"demo-company-policy.pdf","page":2,"quote":"事先获得主管批准","answer_pattern":"主管.*批准|批准.*主管"}]},
